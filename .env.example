# EM-A2A Environment Configuration
# Copy this file to .env and fill in your values

# =========================================================================
# TRON Network Configuration
# =========================================================================
# Private key for the deployer account (without 0x prefix for TronWeb)
PRIVATE_KEY=your_private_key_here

# TRON full node API (Shasta testnet)
TRON_FULL_NODE=https://api.shasta.trongrid.io
TRON_SOLIDITY_NODE=https://api.shasta.trongrid.io
TRON_EVENT_SERVER=https://api.shasta.trongrid.io
TRON_PRIVATE_KEY=your_tron_private_key_here

# TRON API key (from trongrid.io)
TRON_API_KEY=your_tron_api_key_here

# TRON mainnet RPC (for production deployment)
TRON_MAINNET_RPC=https://api.trongrid.io

# TronScan API key (for contract verification)
TRONSCAN_API_KEY=your_tronscan_api_key_here

# Multisig address (ownership transferred after mainnet deploy)
MULTISIG_ADDRESS=
INITIAL_OPERATOR=

# =========================================================================
# Contract Addresses (filled after deployment)
# =========================================================================
CONTRACT_AGENT_REGISTRY=
CONTRACT_REVENUE_SPLITTER=
CONTRACT_ESCROW_SERVICE=
CONTRACT_MICRO_PAYMENT=

# =========================================================================
# Product Configuration
# =========================================================================
# A2A Pay — product ID for revenue splitter
A2A_PAY_PRODUCT_ID=a2a-pay
A2A_MARKET_PRODUCT_ID=a2a-market
A2A_LEND_PRODUCT_ID=a2a-lend

# =========================================================================
# Database
# =========================================================================
# Path for SQLite databases (relative to project root)
DB_PATH=./data
