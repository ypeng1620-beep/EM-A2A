{
  "name": "@poisonpyf/a2a-mcp",
  "version": "0.1.2",
  "description": "EM-A2A MCP Server — Agent-to-Agent payments, escrow, credit, and identity tools for AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "a2a-mcp": "a2a-mcp.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "a2a",
    "agent-to-agent",
    "mcp",
    "model-context-protocol",
    "payment",
    "escrow",
    "tron",
    "usdc",
    "blockchain",
    "ai-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@poisonpyf/a2a-core": "workspace:*",
    "@poisonpyf/a2a-pay": "workspace:*",
    "@poisonpyf/a2a-credit": "workspace:*",
    "@poisonpyf/a2a-id": "workspace:*",
    "@poisonpyf/a2a-compliance": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
